// ================= sinks =================
prometheus.remote_write "vm" {
    endpoint { url = "http://victoria-metrics.observability.svc.cluster.local:8428/api/v1/write" }
}

loki.write "loki" {
    endpoint { url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push" }
}

// ================= pod logs: tail kubelet log files on this node =================
// Targets come from Kubernetes discovery, not a bare glob. Walked 2026-11-14:
// the old `/var/log/pods/*/*/*.log` glob gave every stream the SAME three
// labels (job / instance / filename-with-uuid-path) — nothing was filterable,
// and Grafana Explore showed only the chatty pods (argocd, postgres).
// discovery.kubernetes "pods" (defined HERE; the metrics section below reuses
// it for the annotated-pod scrape) carries every pod's metadata; the relabel
// builds the per-pod log path from the pod's OWN uid + container name (the uid
// means restarting pods never share a tail position) and stamps the estate's
// LOG-LABEL CONTRACT onto every line: env, app, namespace, pod, container.
// HOW TO ADD A LABEL: one replace rule copying
// `__meta_kubernetes_pod_label_<x>` (dashes/dots in the label name become
// underscores). System pods (argocd, kube-system, cert-manager) carry no
// `omicron/env` label — their streams simply have no env label; `app` falls
// back to `app.kubernetes.io/name` where the short `app` label is missing.
discovery.kubernetes "pods" { role = "pod" }
discovery.relabel "pod_logs" {
    targets = discovery.kubernetes.pods.targets
    // terminal-phase pods (completed Jobs) stop being tailed — their logs
    // stay readable with kubectl logs.
    rule {
    action        = "drop"
    regex         = "Pending|Succeeded|Failed|Completed"
    source_labels = ["__meta_kubernetes_pod_phase"]
    }
    rule {
    action       = "replace"
    target_label = "job"
    replacement  = "kubelet-pods"
    }
    rule {
    action       = "replace"
    target_label = "instance"
    replacement  = env("HOSTNAME")
    }
    // /var/log/pods/<ns>_<pod>_<uid>/<container>/<n>.log
    rule {
    action        = "replace"
    separator     = ";"
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    regex         = "(.+);(.+)"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*_${1}/${2}/*.log"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
    }
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_label_omicron_env"]
    target_label  = "env"
    }
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
    }
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
    }
}
loki.source.file "pod_logs" {
    targets    = discovery.relabel.pod_logs.output
    forward_to = [loki.write.loki.receiver]
    // __path__ above is a per-pod GLOB, not a literal file — file_match
    // expands it; without this block loki.source.file demands absolute paths.
    file_match {
    enabled = true
    }
}

// ================= master host logs: rsyslog forwarding lands here =================
// master's /etc/rsyslog.d/50-omk3s.conf ships journald+daemon logs to :5514/udp
loki.source.syslog "master" {
    listener {
        protocol = "udp"
        address  = "0.0.0.0:5514"
    }
    forward_to = [loki.write.loki.receiver]
}

// ================= metrics: kubelet + cAdvisor (via the API-server proxy) =================
// The scrape rides the Kubernetes API-server proxy —
//   kubernetes.default.svc.cluster.local:443 + /api/v1/nodes/<node>/proxy/metrics[.../cadvisor]
// — instead of dialing each node's InternalIP:10250. Walked 2026-11-14 on k3d:
// direct node dialing was up=0 for EVERY target while the same namespace could
// reach pod endpoints fine (cert-manager:9402 -> HTTP 200 from a sibling pod);
// the proxy path works from ANY pod that holds `nodes/proxy` (the alloy
// ClusterRole does — verified via can-i impersonation) with zero node-network
// reachability, and is identical on k3d and the real VPS. The SA bearer doubles
// as the proxy's auth (kubelet webhook authz maps to nodes/proxy).
// RIVER SYNTAX NOTE (walked 2026-11-14): block BODIES are newline-separated —
// comma-joined attributes (`rule { a = 1, b = 2 }`) are a parse error
// ("expected TERMINATOR, got ,"), and one such line kept the whole DaemonSet
// in CrashLoopBackOff for 6h. Only attribute-VALUE object literals
// (`authorization = { x = 1, y = 2 }`) may use commas. One attribute per line.
// RELABEL DEFAULT GOTCHA (walked 2026-11-14): `replacement` defaults to "$1" —
// a multi-capture rule that omits it silently DISCARDS capture 2+ (the
// annotated-pod port rewrite lost :9402/:9090/:3000 and scraped port 80, up=0
// across the board). Always spell replacement out.
discovery.kubernetes "nodes" { role = "node" }
discovery.relabel "kubelet" {
    targets = discovery.kubernetes.nodes.targets
    rule {
    action        = "replace"
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc.cluster.local:443"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/${1}/proxy/metrics"
    }
    rule {
    action        = "replace"
    target_label  = "node"
    source_labels = ["__meta_kubernetes_node_name"]
    }
}
discovery.relabel "cadvisor" {
    targets = discovery.kubernetes.nodes.targets
    rule {
    action        = "replace"
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc.cluster.local:443"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/${1}/proxy/metrics/cadvisor"
    }
    rule {
    action        = "replace"
    target_label  = "node"
    source_labels = ["__meta_kubernetes_node_name"]
    }
}
prometheus.scrape "kubelet" {
    targets       = discovery.relabel.kubelet.output
    scheme        = "https"
    metrics_path  = "/metrics"   // default; __metrics_path__ from the relabel wins per-target
    authorization {
        type             = "Bearer"
        credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
    tls_config {
        ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        server_name = "kubernetes.default.svc.cluster.local"
    }
    forward_to    = [prometheus.remote_write.vm.receiver]
    job_name      = "kubelet"
}
prometheus.scrape "cadvisor" {
    targets       = discovery.relabel.cadvisor.output
    scheme        = "https"
    metrics_path  = "/metrics"   // default; __metrics_path__ from the relabel wins per-target
    authorization {
        type             = "Bearer"
        credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
    tls_config {
        ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        server_name = "kubernetes.default.svc.cluster.local"
    }
    forward_to    = [prometheus.remote_write.vm.receiver]
    job_name      = "cadvisor"
}

// ================= metrics: NODE-level cpu/memory (the resource endpoint) =================
// kubelet splits its surfaces: /metrics carries kubelet_* + volume stats, and
// the per-NODE resource series (node_cpu_usage_seconds_total,
// node_memory_working_set_bytes, ...) live on /metrics/resource (walked
// 2026-11-14 — absent from the plain /metrics dump). Per-POD cpu/mem/disk come
// from cAdvisor above; this is the node aggregate for the same three.
discovery.relabel "noderes" {
    targets = discovery.kubernetes.nodes.targets
    rule {
    action        = "replace"
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc.cluster.local:443"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/${1}/proxy/metrics/resource"
    }
    rule {
    action        = "replace"
    target_label  = "node"
    source_labels = ["__meta_kubernetes_node_name"]
    }
}
prometheus.scrape "noderes" {
    targets       = discovery.relabel.noderes.output
    scheme        = "https"
    metrics_path  = "/metrics"   // default; __metrics_path__ from the relabel wins per-target
    authorization {
        type             = "Bearer"
        credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
    tls_config {
        ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        server_name = "kubernetes.default.svc.cluster.local"
    }
    forward_to    = [prometheus.remote_write.vm.receiver]
    job_name      = "kubelet-resource"
}

// ================= metrics: annotated app pods (the /metrics contract) =================
// Pods opt in with prometheus.io/{scrape,port,path} annotations — see Phase 5.
// ENV ATTRIBUTION (feat/environments): there is NO per-environment Alloy
// external_labels mechanism — one DaemonSet fleet watches every namespace
// and cannot stamp "which env am I". The pipeline instead COPIES the pod
// label omicron/env (shared|staging|production — stamped by every overlay's
// labels transformer onto pod templates) into a normalized `env` label.
// The env trees are what make this true; Grafana queries/boards filter on
// env=... (see applications/observability/README.md). Unlabeled pods
// (system components, pre-contract strays) simply get no env label.
// discovery.kubernetes "pods" is defined in the POD LOGS section above —
// this relabel consumes the SAME discovery, filtered to the annotation
// contract. Pods NOT annotated (system components, pre-contract strays)
// simply get no env label.
discovery.relabel "pod_metrics" {
    targets = discovery.kubernetes.pods.targets
    rule {
    action       = "keep"
    regex        = "true"
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    }
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    target_label  = "__metrics_path__"
    }
    rule {
    action        = "replace"
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    separator     = ";"
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    target_label  = "__address__"
    replacement   = "$1:$2"
    // Replacement is SPELLED OUT deliberately: the "$1" DEFAULT silently
    // drops capture 2 (the port) — the target then scrapes port 80 and
    // every annotated pod reported up=0 (walked 2026-11-14).
    }
    rule {
    action       = "labelmap"
    regex        = "__meta_kubernetes_pod_label_(.+)"
    }
    // omicron/env -> env (meta-label sanitization: `omicron/env` becomes
    // `__meta_kubernetes_pod_label_omicron_env`; empty stays empty -> drop
    // the target_label rewrite when the source is missing is automatic for
    // replace with non-matching regex — the default rule keeps it absent).
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_label_omicron_env"]
    target_label  = "env"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
    }
}
prometheus.scrape "pod_metrics" {
    targets    = discovery.relabel.pod_metrics.output
    forward_to = [prometheus.remote_write.vm.receiver]
    job_name   = "annotated-pods"
}

// ================= OTLP ingest (metrics + logs; TRACES OFF — no Tempo) =================
// FIRST LIVE PRODUCER (walked 2026-11-14): traefik pushes its OpenTelemetry
// metrics to this receiver (`--set metrics.otlp.http.endpoint=...alloy:4318`
// in runbook ch.03 §6) — the ONLY path carrying the OTel semconv
// http.server.request.duration histogram, which lands in VictoriaMetrics as
// http_server_request_duration_seconds_{bucket,sum,count} (job="traefik").
// THE OWNERSHIP SPLIT: traefik's push ALSO carries its own traefik_* counters
// that the Prometheus PULL above already exports — without the filter those
// families would exist TWICE with different label sets (job="traefik" vs
// job="annotated-pods"), and every unfiltered sum(rate(...)) would
// double-count. The filter drops ^traefik_ from the push stream:
//   pull  = the one source of traefik_* families
//   push  = the one source of the semconv HTTP metrics
otelcol.processor.filter "semconv_only" {
    error_mode = "ignore"
    metric_conditions {
    conditions = [
        `IsMatch(name, "^traefik_")`,
    ]
    context = "metric"
    }
    output {
    metrics = [otelcol.exporter.prometheus.m2vm.input]
    }
}
otelcol.receiver.otlp "in" {
    grpc { endpoint = "0.0.0.0:4317" }
    http { endpoint = "0.0.0.0:4318" }
    // traces intentionally absent: no Tempo (§1). Enable when/if a trace store exists.
    output {
    metrics = [otelcol.processor.filter.semconv_only.input]
    logs    = [otelcol.exporter.loki.m2loki.input]
    }
}
otelcol.exporter.prometheus "m2vm" {
    // Traefik's resource attributes (its auto-detected k8s.namespace.name /
    // k8s.pod.name / k8s.pod.uid, plus service.name -> the job label) become
    // LABELS on every converted metric — the OTLP counterpart of the log
    // env-label contract above. CAVEAT (VPS): attribute auto-detection needs
    // pod networking — on the hostNetwork VPS shape the k8s.* attrs are
    // absent (the semconv request labels still carry the rest).
    resource_to_telemetry_conversion = true
    forward_to = [prometheus.remote_write.vm.receiver]
}
otelcol.exporter.loki "m2loki" {
    forward_to = [loki.write.loki.receiver]
}

