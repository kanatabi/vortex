// ================= sinks =================
prometheus.remote_write "vm" {
    endpoint { url = "http://victoria-metrics.observability.svc.cluster.local:8428/api/v1/write" }
}

loki.write "loki" {
    endpoint { url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push" }
}

// ================= pod logs: tail kubelet log files on this node =================
local.file_match "pod_logs" {
    path_targets = [{
    __path__  = "/var/log/pods/*/*/*.log",
    instance  = env("HOSTNAME"),
    job       = "kubelet-pods",
    }]
}
loki.source.file "pod_logs" {
    targets    = local.file_match.pod_logs.targets
    forward_to = [loki.write.loki.receiver]
}

// ================= master host logs: rsyslog forwarding lands here =================
// master's /etc/rsyslog.d/50-omk3s.conf ships journald+daemon logs to :5514/udp
loki.source.syslog "master" {
    listener {
        protocol = "udp"
        address  = "0.0.0.0:5514"
    }
    forward_to = [loki.write.loki.receiver]
}

// ================= metrics: kubelet + cAdvisor (via the API-server proxy) =================
// The scrape rides the Kubernetes API-server proxy —
//   kubernetes.default.svc.cluster.local:443 + /api/v1/nodes/<node>/proxy/metrics[.../cadvisor]
// — instead of dialing each node's InternalIP:10250. Walked 2026-11-14 on k3d:
// direct node dialing was up=0 for EVERY target while the same namespace could
// reach pod endpoints fine (cert-manager:9402 -> HTTP 200 from a sibling pod);
// the proxy path works from ANY pod that holds `nodes/proxy` (the alloy
// ClusterRole does — verified via can-i impersonation) with zero node-network
// reachability, and is identical on k3d and the real VPS. The SA bearer doubles
// as the proxy's auth (kubelet webhook authz maps to nodes/proxy).
// RIVER SYNTAX NOTE (walked 2026-11-14): block BODIES are newline-separated —
// comma-joined attributes (`rule { a = 1, b = 2 }`) are a parse error
// ("expected TERMINATOR, got ,"), and one such line kept the whole DaemonSet
// in CrashLoopBackOff for 6h. Only attribute-VALUE object literals
// (`authorization = { x = 1, y = 2 }`) may use commas. One attribute per line.
// RELABEL DEFAULT GOTCHA (walked 2026-11-14): `replacement` defaults to "$1" —
// a multi-capture rule that omits it silently DISCARDS capture 2+ (the
// annotated-pod port rewrite lost :9402/:9090/:3000 and scraped port 80, up=0
// across the board). Always spell replacement out.
discovery.kubernetes "nodes" { role = "node" }
discovery.relabel "kubelet" {
    targets = discovery.kubernetes.nodes.targets
    rule {
    action        = "replace"
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc.cluster.local:443"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/${1}/proxy/metrics"
    }
    rule {
    action        = "replace"
    target_label  = "node"
    source_labels = ["__meta_kubernetes_node_name"]
    }
}
discovery.relabel "cadvisor" {
    targets = discovery.kubernetes.nodes.targets
    rule {
    action        = "replace"
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc.cluster.local:443"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/${1}/proxy/metrics/cadvisor"
    }
    rule {
    action        = "replace"
    target_label  = "node"
    source_labels = ["__meta_kubernetes_node_name"]
    }
}
prometheus.scrape "kubelet" {
    targets       = discovery.relabel.kubelet.output
    scheme        = "https"
    metrics_path  = "/metrics"   // default; __metrics_path__ from the relabel wins per-target
    authorization {
        type             = "Bearer"
        credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
    tls_config {
        ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        server_name = "kubernetes.default.svc.cluster.local"
    }
    forward_to    = [prometheus.remote_write.vm.receiver]
    job_name      = "kubelet"
}
prometheus.scrape "cadvisor" {
    targets       = discovery.relabel.cadvisor.output
    scheme        = "https"
    metrics_path  = "/metrics"   // default; __metrics_path__ from the relabel wins per-target
    authorization {
        type             = "Bearer"
        credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
    tls_config {
        ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        server_name = "kubernetes.default.svc.cluster.local"
    }
    forward_to    = [prometheus.remote_write.vm.receiver]
    job_name      = "cadvisor"
}

// ================= metrics: annotated app pods (the /metrics contract) =================
// Pods opt in with prometheus.io/{scrape,port,path} annotations — see Phase 5.
// ENV ATTRIBUTION (feat/environments): there is NO per-environment Alloy
// external_labels mechanism — one DaemonSet fleet watches every namespace
// and cannot stamp "which env am I". The pipeline instead COPIES the pod
// label omicron/env (shared|staging|production — stamped by every overlay's
// labels transformer onto pod templates) into a normalized `env` label.
// The env trees are what make this true; Grafana queries/boards filter on
// env=... (see applications/observability/README.md). Unlabeled pods
// (system components, pre-contract strays) simply get no env label.
discovery.kubernetes "pods" { role = "pod" }
discovery.relabel "pod_metrics" {
    targets = discovery.kubernetes.pods.targets
    rule {
    action       = "keep"
    regex        = "true"
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    }
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    target_label  = "__metrics_path__"
    }
    rule {
    action        = "replace"
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    separator     = ";"
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    target_label  = "__address__"
    replacement   = "$1:$2"
    // Replacement is SPELLED OUT deliberately: the "$1" DEFAULT silently
    // drops capture 2 (the port) — the target then scrapes port 80 and
    // every annotated pod reported up=0 (walked 2026-11-14).
    }
    rule {
    action       = "labelmap"
    regex        = "__meta_kubernetes_pod_label_(.+)"
    }
    // omicron/env -> env (meta-label sanitization: `omicron/env` becomes
    // `__meta_kubernetes_pod_label_omicron_env`; empty stays empty -> drop
    // the target_label rewrite when the source is missing is automatic for
    // replace with non-matching regex — the default rule keeps it absent).
    rule {
    action        = "replace"
    regex         = "(.+)"
    source_labels = ["__meta_kubernetes_pod_label_omicron_env"]
    target_label  = "env"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
    }
    rule {
    action        = "replace"
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
    }
}
prometheus.scrape "pod_metrics" {
    targets    = discovery.relabel.pod_metrics.output
    forward_to = [prometheus.remote_write.vm.receiver]
    job_name   = "annotated-pods"
}

// ================= OTLP ingest (metrics + logs; TRACES OFF — no Tempo) =================
otelcol.receiver.otlp "in" {
    grpc { endpoint = "0.0.0.0:4317" }
    http { endpoint = "0.0.0.0:4318" }
    // traces intentionally absent: no Tempo (§1). Enable when/if a trace store exists.
    output {
        metrics = [otelcol.exporter.prometheus.m2vm.input]
        logs    = [otelcol.exporter.loki.m2loki.input]
    }
}
otelcol.exporter.prometheus "m2vm" {
    forward_to = [prometheus.remote_write.vm.receiver]
}
otelcol.exporter.loki "m2loki" {
    forward_to = [loki.write.loki.receiver]
}

